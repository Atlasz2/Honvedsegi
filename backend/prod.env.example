# ============================================================================
#  Másold ezt a fájlt 'prod.env' néven, és töltsd ki valódi értékekkel.
#  A prod.env NEM kerül gitbe (lásd a gyökér .gitignore-t).
#
#  A jelszavak CSAK az első indításkor kellenek: ekkor jönnek létre a kezdeti
#  felhasználók. Utána a rendszer már a saját adatbázisát használja.
# ============================================================================

# Kötelező (kezdeti felhasználók):
BACKEND_ADMIN_PASSWORD=ide-egy-erős-jelszót
BACKEND_DEV_MASTER_PASSWORD=ide-egy-másik-erős-jelszót
BACKEND_READER_PASSWORD=ide-egy-erős-jelszót
BACKEND_EDITOR_PASSWORD=ide-egy-erős-jelszót

# A legmagasabb (god / dev_master) szintű fiók felhasználóneve.
# Ha megadod, a valódi god-felhasználónév NEM szerepel a forráskódban — csak te
# ismered. Alapérték (ha üresen hagyod): dev_master. Éles telepítésen erősen
# ajánlott egyedi, nem kitalálható értéket adni. Telepítés után NE változtasd,
# különben a rendszer új god-fiókot hoz létre, a régit pedig adminná fokozza.
BACKEND_DEV_MASTER_USERNAME=

# Ajánlott (jelszó-hash és munkamenet-token extra sózása). Adj meg hosszú,
# véletlenszerű értékeket. Ha megadod, telepítés után NE változtasd, különben
# a meglévő jelszavak/munkamenetek érvénytelenné válnak.
BACKEND_PASSWORD_PEPPER=
BACKEND_TOKEN_PEPPER=
